        },
        {
          "name": "Dual AI Layout (hdl agy claude)",
          "icon": "👥",
          "action": "omarchy-launch-or-focus herdr-hdl 'kitty --title herdr -e bash -ic \"herdr && hdl agy claude\"'"
        },
        {
          "name": "4-Agent Swarm (hsl 4 agy)",
          "icon": "🐝",
          "action": "omarchy-launch-or-focus herdr-hsl 'kitty --title herdr -e bash -ic \"herdr && hsl 4 agy\"'"
