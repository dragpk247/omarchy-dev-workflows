{
  "active_workflow": "ai-assisted",
  "workflows": [
    {
      "id": "ai-assisted",
      "name": "AI-Assisted Prototyping",
      "icon": "\udb81\udc6e",
      "description": "Antigravity, Claude Code, Ollama, Dropdown Kitty",
      "tools": [
        {
          "name": "Antigravity (agy)",
          "icon": "\ud83e\udd16",
          "action": "omarchy-launch-or-focus agy 'kitty --title agy -e agy'"
        },
        {
          "name": "Claude Code",
          "icon": "\u26a1",
          "action": "omarchy-launch-or-focus claude 'kitty --title claude -e claude'"
        },
        {
          "name": "Codex CLI",
          "icon": "\ud83d\udcbb",
          "action": "omarchy-launch-or-focus codex 'kitty --title codex -e codex'"
        },
        {
          "name": "Ollama Chat",
          "icon": "\ud83e\udd99",
          "action": "setsid kitty --title 'Ollama Chat' -e ollama run llama3 >/dev/null 2>&1 &"
        },
        {
          "name": "Dropdown Scratchpad",
          "icon": "\uf489",
          "action": "toggle-dropdown-terminal"
        }
      ]
    },
    {
      "id": "fullstack-web",
      "name": "Full-Stack Web & Cloud",
      "icon": "\udb81\udd9f",
      "description": "Neovim, Tmux, Lazygit, Docker, Node/Mise",
      "tools": [
        {
          "name": "Neovim Editor",
          "icon": "\ue6ae",
          "action": "omarchy-launch-or-focus nvim 'kitty --title nvim -e nvim'"
        },
        {
          "name": "Tmux Workspace",
          "icon": "\uf489",
          "action": "omarchy-launch-or-focus tmux-dev 'kitty --title tmux-dev -e tmux new-session -A -s dev'"
        },
        {
          "name": "Lazygit Git Client",
          "icon": "\udb80\udea2",
          "action": "omarchy-launch-or-focus lazygit 'kitty --title lazygit -e lazygit'"
        },
        {
          "name": "Project Switcher (fzf)",
          "icon": "\uf002",
          "action": "project-switcher"
        },
        {
          "name": "Docker Status & Containers",
          "icon": "\udb82\udc68",
          "action": "setsid kitty --title 'Docker Containers' -e bash -c 'docker ps; exec bash' >/dev/null 2>&1 &"
        }
      ]
    },
    {
      "id": "systems-performance",
      "name": "Systems & Performance",
      "icon": "\udb80\udd5f",
      "description": "Rust, Btop, Systemd Logs, Hyprland Config",
      "tools": [
        {
          "name": "Btop System Monitor",
          "icon": "\udb80\udd2a",
          "action": "omarchy-launch-or-focus btop 'kitty --title btop -e btop'"
        },
        {
          "name": "Hyprland Config Editor",
          "icon": "\uf359",
          "action": "omarchy-launch-or-focus-tui nvim ~/.config/hypr/bindings.lua"
        },
        {
          "name": "Journalctl System Logs",
          "icon": "\ud83d\udcdc",
          "action": "setsid kitty --title 'System Logs' -e journalctl --user -f >/dev/null 2>&1 &"
        },
        {
          "name": "ASUS Power Profile Cycle",
          "icon": "\u26a1",
          "action": "asus-profile-toggle"
        },
        {
          "name": "ASUS Battery Limit Toggle",
          "icon": "\ud83d\udd0b",
          "action": "asus-battery-toggle"
        }
      ]
    }
  ]
}